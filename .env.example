# Copie este arquivo para ".env" (mesma pasta do docker-compose.yml) e preencha
# com os dados reais antes de rodar em produção. O ".env" nunca deve ser versionado.

# Senha do Postgres (achado de revisão de segurança: antes vinha fixa como "cambia" no
# docker-compose.yml). Continua com esse valor por padrão em dev — TROQUE por uma senha
# forte antes de rodar num servidor real, especialmente porque a porta 5432 fica
# publicada no host por padrão (ver README.md, seção de limitações conhecidas).
POSTGRES_PASSWORD=cambia

# Nome/IP do servidor gravado no certificado HTTPS autoassinado do reverse-proxy
# (Fase 3A da revisão de segurança) — troque pelo IP ou domínio real antes de acessar de
# outra máquina que não seja a própria (ex: CERT_CN=192.168.1.50 ou
# CERT_CN=cambia.suaempresa.local). "localhost" só serve pra testar na própria máquina.
CERT_CN=localhost

# Endereço em que o NAVEGADOR do usuário final vai acessar o backend. Desde a Fase 3A,
# front-end e backend ficam atrás do MESMO reverse-proxy HTTPS (mesma origem) — o padrão
# (vazio = caminho relativo) já funciona sem precisar definir nada aqui. Só preencha isto
# se estiver rodando SEM o reverse-proxy (backend numa porta própria, endereço diferente
# do front-end) — é "assado" dentro dos arquivos estáticos no momento do build
# (docker compose build), não é lido em tempo de execução.
VITE_API_URL=

# ---------------------------------------------------------------------------
# Envio do link mágico de login por e-mail
# ---------------------------------------------------------------------------
# CAMBIA_MAIL_HABILITADO=false (ou a linha toda removida/comentada): modo mais
# simples, não exige nenhuma configuração de SMTP. O sistema funciona
# normalmente, mas não envia e-mail nenhum — o link de acesso só aparece no
# log do backend (`docker compose logs backend | grep "Link mágico"`). Bom
# para desenvolvimento/demonstração/homologação.
#
# CAMBIA_MAIL_HABILITADO=true: liga o envio real do e-mail. SÓ FUNCIONA se
# você TAMBÉM preencher um dos dois blocos de SMTP logo abaixo (Opção 1 —
# produção de verdade, ou Opção 2 — Mailpit para teste). Ligar isto sem
# configurar um dos dois blocos faz o envio falhar.
CAMBIA_MAIL_HABILITADO=true
CAMBIA_MAIL_REMETENTE=nao-responda@suaempresa.com.br

# ---------------------------------------------------------------------------
# Opção 1 — produção de verdade: relay SMTP do Microsoft 365 / Exchange Online
# no Azure (host smtp.office365.com, porta 587). Funciona com qualquer servidor
# SMTP autenticado, não é específico da Microsoft. Use isto quando tiver as
# credenciais reais (plano do Azure contratado).
# ---------------------------------------------------------------------------
SPRING_MAIL_HOST=smtp.office365.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=nao-responda@suaempresa.com.br
SPRING_MAIL_PASSWORD=
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_SMTP_STARTTLS=true

# ---------------------------------------------------------------------------
# Opção 2 — teste local com Mailpit (sem credenciais, sem enviar e-mail de
# verdade pra ninguém): o docker-compose.yml já sobe um serviço "mailpit".
# Comente o bloco acima e descomente este pra usar. A interface web do Mailpit
# fica em http://localhost:8025 — todo e-mail "enviado" pelo sistema aparece lá.
# ---------------------------------------------------------------------------
# SPRING_MAIL_HOST=mailpit
# SPRING_MAIL_PORT=1025
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
# SPRING_MAIL_SMTP_AUTH=false
# SPRING_MAIL_SMTP_STARTTLS=false
